# Alpaca Paper Trading Credentials (supports both ID/Key variants)
# Obtain your API keys from your Alpaca dashboard (Paper trading account recommended)
APCA_API_KEY_ID=
APCA_API_KEY=
APCA_API_SECRET_KEY=
APCA_API_SECRET=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# Core Strategy & Capital Settings
INITIAL_CAPITAL=10000.0
BASE_CURRENCY=USD
MAX_DEEP_CANDIDATES=5
MIN_CANDIDATE_SCORE=0.60

# Risk Management Settings
RISK_PER_TRADE_PCT=0.50
MAX_POSITION_PCT=20.0
MAX_SINGLE_POSITION_PCT=90.0
ISOLATED_OPPORTUNITY_MAX_PCT=65.0
MAX_PORTFOLIO_RISK_PCT=2.0
MAX_DAILY_LOSS_PCT=2.0
MAX_CONSECUTIVE_ERRORS=5

# Commission & Fee Settings
COMMISSION_PER_ORDER_USD=0.0
COMMISSION_PER_SHARE_USD=0.0
ESTIMATED_REGULATORY_FEE_PER_SHARE=0.000195
ESTIMATED_SEC_FEE_RATE=0.0000206
ESTIMATED_TAF_CAP_USD=9.79
ESTIMATED_CAT_FEE_PER_SHARE=0.000003
MIN_GROSS_TO_COST_MULTIPLE=3.0
MIN_REWARD_RISK=0.0
MIN_TARGET_PCT=0.0

# Paper Trading Simulation Settings
PAPER_SLIPPAGE_BPS=5.0
PAPER_COMMISSION_BPS=2.0

# Data Feed & Screening Settings
ALPACA_DATA_FEED=iex
ENABLE_TREND_CONTINUATION=false
MIN_LATEST_CLOSE=5.0
MIN_MEDIAN_CLOSE_5=5.0
MIN_VALID_DAILY_BARS=15
LOOKBACK_SESSIONS=20
MIN_MEDIAN_DOLLAR_VOLUME=10000000.0
MIN_ATR_PCT=0.01
MAX_ATR_PCT=0.10
MAX_DAILY_POOL_SIZE=200

# Session Timing & Resilience Settings
FLATTEN_MINUTES_BEFORE_CLOSE=5
NO_NEW_ENTRIES_MINUTES_BEFORE_CLOSE=30
MAX_WAIT_FOR_OPEN_MINUTES=45
ALPACA_HTTP_CONNECT_TIMEOUT=5.0
ALPACA_HTTP_READ_TIMEOUT=20.0
MAX_OUTAGE_MINUTES=15
FLATTEN_MAX_WAIT_SECONDS=600
